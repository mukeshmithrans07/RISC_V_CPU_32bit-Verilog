//program to calculate first 10 fibonacci numbers.
00000093 // 0x00: addi x1, x0, 0 
00100113 // 0x04: addi x2, x0, 1 
00A00213 // 0x08: addi x4, x0, 10  
002081B3 // 0x0C: LOOP: add x3, x1, x2 
002000B3 // 0x10: add x1, x0, x2  
00300133 // 0x14: add x2, x0, x3  
FFF20213 // 0x18: addi x4, x4, -1 
FE0218E3 // 0x1C: bne x4, x0, LOOP